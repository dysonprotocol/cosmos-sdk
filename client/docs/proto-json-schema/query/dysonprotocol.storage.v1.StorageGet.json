{
    "request": {
        "$schema": "http://json-schema.org/draft-04/schema#",
        "$ref": "#/definitions/dysonprotocol.storage.v1.QueryStorageGetRequest",
        "definitions": {
            "dysonprotocol.storage.v1.QueryStorageGetRequest": {
                "properties": {
                    "owner": {
                        "type": "string",
                        "description": "Owner identifier to look up by. Accepts either: - a nameservice name (e.g. \"alice.dys\"), which will be resolved to an address, or - a bech32 address directly Resolution is performed server-side prior to querying the store."
                    },
                    "index": {
                        "type": "string",
                        "description": "The index of the storage entry."
                    },
                    "extract": {
                        "type": "string",
                        "description": "The gjson path to extract from the storage entry."
                    }
                },
                "additionalProperties": false,
                "type": "object",
                "title": "Query Storage Get Request"
            }
        }
    },
    "response": {
        "$schema": "http://json-schema.org/draft-04/schema#",
        "$ref": "#/definitions/dysonprotocol.storage.v1.QueryStorageGetResponse",
        "definitions": {
            "dysonprotocol.storage.v1.QueryStorageGetResponse": {
                "properties": {
                    "entry": {
                        "$ref": "#/definitions/dysonprotocol.storage.v1.Storage",
                        "additionalProperties": false
                    }
                },
                "additionalProperties": false,
                "type": "object",
                "title": "Query Storage Get Response"
            },
            "dysonprotocol.storage.v1.Storage": {
                "properties": {
                    "owner": {
                        "type": "string",
                        "description": "owner is the account address that owns this storage entry."
                    },
                    "index": {
                        "type": "string",
                        "description": "index is the key/index for the storage entry (within the owner's namespace)."
                    },
                    "data": {
                        "type": "string",
                        "description": "data is the stored string value associated with the index."
                    },
                    "updated_height": {
                        "type": "string",
                        "description": "updated_height is block height of last modification."
                    },
                    "updated_timestamp": {
                        "type": "string",
                        "description": "updated_timestamp is the block time in UTC (RFC3339 e.g. \"2025-06-11T15:23:00Z\") when entry was modified."
                    },
                    "hash": {
                        "type": "string",
                        "description": "hash is SHA-256 hex of data field."
                    }
                },
                "additionalProperties": false,
                "type": "object",
                "title": "Storage"
            }
        }
    }
}
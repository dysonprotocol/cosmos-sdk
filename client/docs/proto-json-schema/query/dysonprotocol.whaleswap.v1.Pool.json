{
    "request": {
        "$schema": "http://json-schema.org/draft-04/schema#",
        "$ref": "#/definitions/dysonprotocol.whaleswap.v1.QueryPoolRequest",
        "definitions": {
            "dysonprotocol.whaleswap.v1.QueryPoolRequest": {
                "properties": {
                    "pool_id": {
                        "type": "string"
                    }
                },
                "additionalProperties": false,
                "type": "object",
                "title": "Query Pool Request"
            }
        }
    },
    "response": {
        "$schema": "http://json-schema.org/draft-04/schema#",
        "$ref": "#/definitions/dysonprotocol.whaleswap.v1.QueryPoolResponse",
        "definitions": {
            "dysonprotocol.whaleswap.v1.QueryPoolResponse": {
                "properties": {
                    "pool": {
                        "$ref": "#/definitions/dysonprotocol.whaleswap.v1.Pool",
                        "additionalProperties": false
                    }
                },
                "additionalProperties": false,
                "type": "object",
                "title": "Query Pool Response"
            },
            "cosmos.base.v1beta1.Coin": {
                "properties": {
                    "denom": {
                        "type": "string"
                    },
                    "amount": {
                        "type": "string"
                    }
                },
                "additionalProperties": false,
                "type": "object",
                "title": "Coin",
                "description": "Coin defines a token with a denomination and an amount. NOTE: The amount field is an Int which implements the custom method signatures required by gogoproto."
            },
            "dysonprotocol.whaleswap.v1.Pool": {
                "properties": {
                    "pool_id": {
                        "type": "string"
                    },
                    "coin_a": {
                        "$ref": "#/definitions/cosmos.base.v1beta1.Coin",
                        "additionalProperties": false
                    },
                    "coin_b": {
                        "$ref": "#/definitions/cosmos.base.v1beta1.Coin",
                        "additionalProperties": false
                    },
                    "shares_denom": {
                        "type": "string"
                    },
                    "fee_pct": {
                        "type": "string",
                        "description": "fee_pct is the pool swap fee percentage (cosmos.Dec string in [0,1))."
                    },
                    "min_price": {
                        "items": {
                            "$ref": "#/definitions/cosmos.base.v1beta1.Coin"
                        },
                        "additionalProperties": false,
                        "type": "array",
                        "description": "min_price/max_price optionally set a price band for concentrated liquidity. Each is expressed as exactly two coins representing the ratio coin_b/coin_a. For example, [{amount: 1, denom: coin_a}, {amount: 2, denom: coin_b}] means min P = 2/1 of coin2 per coin1. Empty means unset."
                    },
                    "max_price": {
                        "items": {
                            "$ref": "#/definitions/cosmos.base.v1beta1.Coin"
                        },
                        "additionalProperties": false,
                        "type": "array"
                    },
                    "block_height": {
                        "type": "string"
                    },
                    "created": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "updated": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "num_trades": {
                        "type": "string"
                    },
                    "fees_earned": {
                        "items": {
                            "$ref": "#/definitions/cosmos.base.v1beta1.Coin"
                        },
                        "additionalProperties": false,
                        "type": "array",
                        "description": "cumulative swap fees retained by the pool (accrue to LPs)"
                    }
                },
                "additionalProperties": false,
                "type": "object",
                "title": "Pool",
                "description": "Pool describes AMM pool state. Notes: - coin_a.denom < coin_b.denom lexicographically (canonical order) - fee_pct is a decimal string in [0,1) - min_price/max_price are optional decimal strings defining a price band over   P = coin_b.amount/coin_a.amount. If unset (or effectively [0, +\u221e)) the pool   behaves as constant-product (v2). If set, concentrated-liquidity math   applies. - coin_a.amount/coin_b.amount are sdk.Int strings. - The instantaneous price used by price-based queries is derived from   reserves as P = coin_b / coin_a, consistent with the notes above."
            }
        }
    }
}
{
    "request": {
        "$schema": "http://json-schema.org/draft-04/schema#",
        "$ref": "#/definitions/dysonprotocol.whaleswap.v1.MsgTakeOffer",
        "definitions": {
            "dysonprotocol.whaleswap.v1.MsgTakeOffer": {
                "properties": {
                    "taker": {
                        "type": "string"
                    },
                    "trades": {
                        "items": {
                            "$ref": "#/definitions/dysonprotocol.whaleswap.v1.TakeItem"
                        },
                        "additionalProperties": false,
                        "type": "array"
                    }
                },
                "additionalProperties": false,
                "type": "object",
                "title": "Msg Take Offer",
                "description": "Take one or more offers (batch). - Each TakeItem specifies an offer and optional take_units (sdk.Int string).   If unset, the action attempts to fully fill the remaining units. - The taker must provide payment in base want; any remainder may be provided   via liquid want, which is burned on receipt. The module then pays base have   (or base of liquid have) to the taker."
            },
            "dysonprotocol.whaleswap.v1.TakeItem": {
                "properties": {
                    "offer_id": {
                        "type": "string"
                    },
                    "take_units": {
                        "type": "string",
                        "description": "units to take (sdk.Int string). If empty, take full remaining."
                    }
                },
                "additionalProperties": false,
                "type": "object",
                "title": "Take Item"
            }
        }
    },
    "response": {
        "$schema": "http://json-schema.org/draft-04/schema#",
        "$ref": "#/definitions/dysonprotocol.whaleswap.v1.MsgTakeOfferResponse",
        "definitions": {
            "dysonprotocol.whaleswap.v1.MsgTakeOfferResponse": {
                "properties": {
                    "ok": {
                        "type": "boolean"
                    }
                },
                "additionalProperties": false,
                "type": "object",
                "title": "Msg Take Offer Response"
            }
        }
    }
}
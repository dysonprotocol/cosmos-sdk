    "dysonprotocol.whaleswap.v1.Params": {
      "type": "object",
      "properties": {
        "pfand_per_offer": {
          "$ref": "#/definitions/cosmos.base.v1beta1.Coin",
          "description": "pfand_per_offer is the PFAND coin required for liquid-mode offers."
        },
        "valuation_fee_pct": {
          "type": "string",
          "description": "valuation_fee_pct is the percentage applied per valuation_period."
        },
        "valuation_period": {
          "type": "string",
          "description": "valuation_period defines the time duration to which valuation_fee_pct\napplies."
        },
        "bid_timeout": {
          "type": "string",
          "description": "bid_timeout defines the minimum duration a placed bid must remain pending\nbefore it can be claimed by the bidder."
        },
        "minimum_bid_percent_increase": {
          "type": "string",
          "description": "minimum_bid_percent_increase specifies the minimum percent increase\nrequired over the current valuation for a new bid to be accepted."
        }
      }
    },
    "dysonprotocol.whaleswap.v1.Pool": {
      "type": "object",
      "properties": {
        "pool_id": {
          "type": "string",
          "format": "uint64"
        },
        "coin_a": {
          "$ref": "#/definitions/cosmos.base.v1beta1.Coin"
        },
        "coin_b": {
          "$ref": "#/definitions/cosmos.base.v1beta1.Coin"
        },
        "shares_denom": {
          "type": "string"
        },
        "fee_pct": {
          "type": "string",
          "description": "fee_pct is the pool swap fee percentage (cosmos.Dec string in [0,1))."
        },
        "min_price": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/cosmos.base.v1beta1.Coin"
          },
          "description": "min_price/max_price optionally set a price band for concentrated liquidity.\nEach is expressed as exactly two coins representing the ratio\ncoin_b/coin_a. For example, [{amount: 1, denom: coin_a}, {amount: 2, denom:\ncoin_b}] means min P = 2/1 of coin2 per coin1. Empty means unset."
        },
        "max_price": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/cosmos.base.v1beta1.Coin"
          }
        },
        "block_height": {
          "type": "string",
          "format": "uint64"
        },
        "created": {
          "type": "string",
          "format": "date-time"
        },
        "updated": {
          "type": "string",
          "format": "date-time"
        },
        "num_trades": {
          "type": "string",
          "format": "uint64"
        },
        "fees_earned": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/cosmos.base.v1beta1.Coin"
          },
          "title": "cumulative swap fees retained by the pool (accrue to LPs)"
        }
      },
      "description": "Pool describes AMM pool state.\n\nNotes:\n- coin_a.denom < coin_b.denom lexicographically (canonical order)\n- fee_pct is a decimal string in [0,1)\n- min_price/max_price are optional decimal strings defining a price band over\n  P = coin_b.amount/coin_a.amount. If unset (or effectively [0, +\u221e)) the pool\n  behaves as constant-product (v2). If set, concentrated-liquidity math\n  applies.\n- coin_a.amount/coin_b.amount are sdk.Int strings."
    },
